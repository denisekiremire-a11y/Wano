# ─────────────────────────────────────────────────────────────────────────────
# Baby registry — environment variables
# Copy to .env.local for local development; set the same names in Vercel for production.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — Supabase dashboard → Project Settings → API (Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public (browser-safe) key — Project Settings → API Keys → "Publishable key" (sb_publishable_…).
# Older projects can use the legacy "anon" key under NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret key — Project Settings → API Keys → "Secret key" (sb_secret_…).
# Used only on the server to call the reservation function. NEVER prefix with NEXT_PUBLIC_.
# Older projects can use the legacy "service_role" key under SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=

# Random string used to hash guests' IP addresses for spam protection (so raw IPs are never
# stored). Generate one with:  openssl rand -hex 32
RESERVATION_HASH_SALT=change-me-to-a-long-random-string

# Protects /api/cron/expire-reservations (only used if you turn on optional reservation
# expiry in Admin → Settings). Vercel Cron sends it automatically. openssl rand -hex 32
CRON_SECRET=change-me-to-another-long-random-string

# ── Optional: email notifications (https://resend.com, free tier) ───────────────────────────
# Without these, nothing is emailed and everything else works the same.
# API key from Resend → API Keys. SERVER-ONLY.
RESEND_API_KEY=
# Where "new reservation" emails go (comma-separate several addresses). With Resend's free test
# sender this must be the email address you signed up to Resend with.
NOTIFY_OWNER_EMAIL=
# Optional: a sender on a domain you've verified in Resend, e.g. "Baby Registry <registry@yourdomain.com>".
# Only when this is set do guests who gave an email also get a confirmation with their "My gifts" link.
NOTIFY_FROM_EMAIL=
# Optional: your site's public address for links in emails, e.g. https://registry.yourfamily.com
# (otherwise taken from the incoming request).
SITE_URL=
