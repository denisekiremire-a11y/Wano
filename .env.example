# Local Postgres (see docker-compose.yml) or a managed provider (Neon, Supabase, RDS...)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pamoja2027"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# After `npm run db:seed` against a local database, demo accounts are created
# with password WanoLocalDev-9214! (see src/db/seed.ts) — traveller
# amina@example.com, vendor jinja.nile.resort@example.com (+4 others), admin
# admin@wano.app. Local dev only — never rendered on any page.

# Admin email notifications (new user/partner signups, club submissions,
# accreditation documents). Get a free API key at https://resend.com/api-keys.
# If unset, notifications are just logged to the server console instead of
# sent — safe for local dev, but means nothing actually arrives anywhere.
RESEND_API_KEY=""

# Must be a domain you've verified in Resend. Until you verify one, leave
# this unset — Resend's shared onboarding@resend.dev address works with no
# setup, but can only deliver to the email on your Resend account.
EMAIL_FROM="Wano <onboarding@resend.dev>"

# Where admin notification emails are sent. Defaults to the same address as
# the site's public support email if unset.
ADMIN_NOTIFICATION_EMAIL="denisekiremire@gmail.com"

# Public base URL, used to build links inside notification emails (e.g. a
# link straight to the new vendor's admin review page).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AFCON 2027 club/anchor feature — see src/lib/feature-flags.ts.
NEXT_PUBLIC_AFCON_CLUB_ENABLED="false"

# Mapbox access token for the AFCON anchor system's real road-distance/
# drive-time lookups (Directions Matrix API). Get one free at
# https://account.mapbox.com/access-tokens/. Without it, distance badges
# silently stay on the haversine "about X km" estimate.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Flutterwave (payment processing for Wano XP paid seats) — sign up at
# https://dashboard.flutterwave.com/signup, get your Secret Key from
# Settings > API, and set a Secret Hash under Settings > Webhooks (must
# match FLUTTERWAVE_WEBHOOK_SECRET_HASH below exactly). Point the
# dashboard's webhook URL at {NEXT_PUBLIC_APP_URL}/api/webhooks/flutterwave.
# Outside of `next dev`, Wano XP booking is refused unless BOTH are set.
# Under `next dev` with no secret key, it falls back to instant-confirm
# with no real payment.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# Bearer token required on cron routes (/api/cron/*) — Vercel Cron sends it
# automatically for crons wired up via vercel.json. If unset, the routes
# refuse every request (503) except under `next dev`.
CRON_SECRET=""
